<UserControl x:Class="WpfApp1.Views.ReservasObjetosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <GroupBox Header="Reservas — Modo Conectado (SqlDataReader / Lista de objetos)">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Toolbar de busqueda por fecha -->
            <Border Grid.Row="0" Margin="0,0,0,12" Padding="0,0,0,12"
                    BorderBrush="{StaticResource BordeBrush}" BorderThickness="0,0,0,1">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Filtrar por fecha:" FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource TextoSecundarioBrush}"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <DatePicker SelectedDate="{Binding FechaBusqueda}" Width="160" Margin="0,0,8,0"/>
                    <Button Content="Buscar por fecha" Command="{Binding BuscarCommand}" Margin="0,0,6,0"/>
                    <Button Content="Ver todas"         Command="{Binding CargarCommand}" Margin="0"/>
                </StackPanel>
            </Border>

            <!-- DataGrid -->
            <DataGrid Grid.Row="1"
                      ItemsSource="{Binding Reservas}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID"       Binding="{Binding ReservaId}"     Width="55"/>
                    <DataGridTextColumn Header="Aula"     Binding="{Binding NombreAula}"    Width="*"/>
                    <DataGridTextColumn Header="Usuario"  Binding="{Binding NombreUsuario}" Width="*"/>
                    <DataGridTextColumn Header="Fecha"    Binding="{Binding Fecha, StringFormat=\{0:dd/MM/yyyy\}}" Width="110"/>
                    <DataGridTextColumn Header="Hora"     Binding="{Binding Hora}"          Width="80"/>
                    <DataGridTextColumn Header="Motivo"   Binding="{Binding Motivo}"        Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </GroupBox>
</UserControl>
