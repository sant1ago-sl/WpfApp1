<Window x:Class="WpfApp1.Views.MainView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:WpfApp1.ViewModels"
        mc:Ignorable="d"
        Title="Gestor de Reservas" Height="650" Width="900"
        MinHeight="500" MinWidth="700"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        Background="{StaticResource FondoBrush}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Barra superior -->
        <Border Grid.Row="0" Background="{StaticResource SuperficieBrush}"
                CornerRadius="12" Padding="18,12" Margin="0,0,0,14"
                BorderBrush="{StaticResource BordeBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Gestor de Reservas" FontSize="17" FontWeight="Bold"
                           Foreground="{StaticResource TextoPrimarioBrush}"/>
                <TextBlock Grid.Column="1" Text="{Binding UsuarioActual}" FontSize="12"
                           Foreground="{StaticResource TextoSecundarioBrush}"
                           VerticalAlignment="Center" Margin="20,0,0,0"/>
            </Grid>
        </Border>

        <!-- Contenido principal -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="215"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Menú lateral -->
            <Border Grid.Column="0" Background="{StaticResource SuperficieBrush}"
                    CornerRadius="12"
                    BorderBrush="{StaticResource BordeBrush}" BorderThickness="1"
                    Margin="0,0,14,0">
                <StackPanel Margin="14">
                    <TextBlock Text="SECCIONES" FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource TextoSecundarioBrush}"
                               Margin="6,0,0,14"/>

                    <Button Content="Aulas · sin conexión" Command="{Binding VerAulasDataTableCommand}"
                            HorizontalContentAlignment="Left" HorizontalAlignment="Stretch" Margin="0,0,0,8"/>
                    <Button Content="Aulas · conectado" Command="{Binding VerAulasObjetosCommand}"
                            HorizontalContentAlignment="Left" HorizontalAlignment="Stretch" Margin="0,0,0,8"/>
                    <Button Content="Reservas · sin conexión" Command="{Binding VerReservasDataTableCommand}"
                            HorizontalContentAlignment="Left" HorizontalAlignment="Stretch" Margin="0,0,0,8"/>
                    <Button Content="Reservas · conectado" Command="{Binding VerReservasObjetosCommand}"
                            HorizontalContentAlignment="Left" HorizontalAlignment="Stretch" Margin="0,0,0,8"/>

                    <Separator Margin="0,14"/>

                    <Button Content="+ Registrar reserva" Command="{Binding VerNuevaReservaCommand}"
                            HorizontalContentAlignment="Left" HorizontalAlignment="Stretch"/>
                </StackPanel>
            </Border>

            <!-- Vista actual -->
            <ContentControl Grid.Column="1" Content="{Binding CurrentView}"/>
        </Grid>

        <!-- Barra de estado -->
        <StatusBar Grid.Row="2" Margin="0,14,0,0" Background="Transparent">
            <StatusBarItem>
                <TextBlock Text="Gestor de Reservas · ADO.NET Semana 03"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>