<Window x:Class="WpfApp1.Views.MainView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Gestor de Reservas" Height="660" Width="940"
        MinHeight="500" MinWidth="720"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        Background="{StaticResource FondoBrush}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Barra superior Fluent -->
        <Border Grid.Row="0" Background="{StaticResource SuperficieBrush}"
                CornerRadius="12" Padding="16,12" Margin="0,0,0,14"
                BorderBrush="{StaticResource BordeBrush}" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="1" Direction="270"
                                  Color="#0F172A" Opacity="0.04"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Logo + Titulo -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="32" Height="32" CornerRadius="9" Margin="0,0,10,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#4F46E5" Offset="0"/>
                                <GradientStop Color="#7C3AED" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="GR" FontSize="12" FontWeight="Bold" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Gestor de Reservas" FontSize="15" FontWeight="Bold"
                               Foreground="{StaticResource TextoPrimarioBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Badge usuario activo -->
                <Border Grid.Column="2" Background="#EEF2FF" CornerRadius="20"
                        Padding="14,5" BorderBrush="#C7D2FE" BorderThickness="1">
                    <TextBlock Text="{Binding UsuarioActual}" FontSize="12"
                               Foreground="#4338CA" FontWeight="SemiBold"/>
                </Border>
            </Grid>
        </Border>

        <!-- Contenido principal -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Menu lateral Fluent -->
            <Border Grid.Column="0" Background="{StaticResource SuperficieBrush}"
                    CornerRadius="12"
                    BorderBrush="{StaticResource BordeBrush}" BorderThickness="1"
                    Margin="0,0,14,0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="1" Direction="270"
                                      Color="#0F172A" Opacity="0.04"/>
                </Border.Effect>
                <StackPanel Margin="12,16,12,12">
                    <TextBlock Text="SECCIONES" FontSize="10" FontWeight="Bold"
                               Foreground="{StaticResource TextoSecundarioBrush}"
                               Margin="8,0,0,10"/>

                    <Button Content="Aulas sin conexion"
                            Command="{Binding VerAulasDataTableCommand}"
                            Style="{StaticResource NavButtonStyle}"
                            HorizontalAlignment="Stretch"/>
                    <Button Content="Aulas conectado"
                            Command="{Binding VerAulasObjetosCommand}"
                            Style="{StaticResource NavButtonStyle}"
                            HorizontalAlignment="Stretch"/>
                    <Button Content="Reservas sin conexion"
                            Command="{Binding VerReservasDataTableCommand}"
                            Style="{StaticResource NavButtonStyle}"
                            HorizontalAlignment="Stretch"/>
                    <Button Content="Reservas conectado"
                            Command="{Binding VerReservasObjetosCommand}"
                            Style="{StaticResource NavButtonStyle}"
                            HorizontalAlignment="Stretch"/>

                    <Separator Margin="4,14" Background="{StaticResource BordeBrush}"/>

                    <Button Content="+ Registrar reserva"
                            Command="{Binding VerNuevaReservaCommand}"
                            HorizontalAlignment="Stretch"/>
                </StackPanel>
            </Border>

            <!-- Vista actual -->
            <ContentControl Grid.Column="1" Content="{Binding CurrentView}"/>
        </Grid>

        <!-- Barra de estado -->
        <StatusBar Grid.Row="2" Margin="0,14,0,0">
            <StatusBarItem>
                <TextBlock Text="Gestor de Reservas  ·  ADO.NET Semana 03"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
