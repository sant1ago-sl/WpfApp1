<Window x:Class="WpfApp1.Views.LoginView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Acceso — Gestor de Reservas" Height="460" Width="700"
        MinHeight="420" MinWidth="640"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        FontFamily="Segoe UI"
        Background="{StaticResource FondoBrush}">

    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>

        <!-- Panel lateral de marca -->
        <Border Grid.Column="0" Background="{StaticResource PrimarioBrush}"
                CornerRadius="16,0,0,16">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24">
                <TextBlock Text="GR" FontSize="44" FontWeight="Bold"
                           Foreground="White" HorizontalAlignment="Center"/>
                <Border Height="2" Width="40" Background="White" Margin="0,10,0,14"/>
                <TextBlock Text="GESTOR DE" FontSize="15" Foreground="#D9DCE8"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="RESERVAS" FontSize="22" FontWeight="Bold"
                           Foreground="White" HorizontalAlignment="Center"/>
                <TextBlock Text="Control de aulas y horarios"
                           FontSize="11" Foreground="#B9BDCF"
                           HorizontalAlignment="Center" Margin="0,10,0,0"/>
            </StackPanel>
        </Border>

        <!-- Panel del formulario -->
        <Border Grid.Column="1" Background="{StaticResource SuperficieBrush}"
                CornerRadius="0,16,16,0"
                BorderBrush="{StaticResource BordeBrush}" BorderThickness="1,1,1,1">
            <StackPanel Margin="36" VerticalAlignment="Center">
                <TextBlock Text="Hola de nuevo"
                           FontSize="22" FontWeight="SemiBold"
                           Foreground="{StaticResource TextoPrimarioBrush}"/>
                <TextBlock Text="Escribe tus datos para entrar"
                           FontSize="12"
                           Foreground="{StaticResource TextoSecundarioBrush}"
                           Margin="0,2,0,20"/>

                <Label Content="Usuario"/>
                <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Escribe tu nombre de usuario"/>

                <Label Content="Contraseña"/>
                <PasswordBox x:Name="passwordBox" PasswordChar="●"
                             PasswordChanged="PasswordBox_PasswordChanged"
                             Background="#F3F4F7" BorderThickness="0"
                             Padding="10,8" Margin="0,0,0,14"/>

                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{StaticResource TextoPrimarioBrush}" FontWeight="SemiBold"
                           FontSize="12" TextWrapping="Wrap"
                           Margin="0,0,0,10"/>

                <Button Content="Entrar al sistema"
                        Command="{Binding LoginCommand}"
                        Height="42" IsDefault="True"/>

                <TextBlock Text="Semana 03 · ADO.NET"
                           FontSize="11"
                           Foreground="{StaticResource TextoSecundarioBrush}"
                           HorizontalAlignment="Center" Margin="0,14,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>