<Window x:Class="WpfApp1.Views.LoginView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Acceso — Gestor de Reservas" Height="480" Width="720"
        MinHeight="440" MinWidth="660"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        FontFamily="Segoe UI"
        Background="{StaticResource FondoBrush}">

    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>

        <!-- Panel lateral de marca — Gradiente Indigo a Violeta -->
        <Border Grid.Column="0" CornerRadius="16,0,0,16">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#4F46E5" Offset="0"/>
                    <GradientStop Color="#7C3AED" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24">
                <Border Width="64" Height="64" CornerRadius="18"
                        Background="White" HorizontalAlignment="Center">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="270"
                                          Color="#1E1B4B" Opacity="0.25"/>
                    </Border.Effect>
                    <TextBlock Text="GR" FontSize="26" FontWeight="Bold"
                               Foreground="{StaticResource PrimarioBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <Border Height="2" Width="48" Background="#FFFFFF44" Margin="0,18,0,14"/>
                <TextBlock Text="GESTOR DE" FontSize="11" Foreground="#C7D2FE"
                           HorizontalAlignment="Center" FontWeight="Bold"/>
                <TextBlock Text="RESERVAS" FontSize="22" FontWeight="Bold"
                           Foreground="White" HorizontalAlignment="Center"/>
                <TextBlock Text="Control de aulas y horarios"
                           FontSize="11" Foreground="#A5B4FC"
                           HorizontalAlignment="Center" Margin="0,8,0,0"/>
            </StackPanel>
        </Border>

        <!-- Panel del formulario -->
        <Border Grid.Column="1" Background="{StaticResource SuperficieBrush}"
                CornerRadius="0,16,16,0"
                BorderBrush="{StaticResource BordeBrush}" BorderThickness="1,1,1,1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="4" Direction="270"
                                  Color="#0F172A" Opacity="0.08"/>
            </Border.Effect>
            <StackPanel Margin="32,22" VerticalAlignment="Center">
                <TextBlock Text="Hola de nuevo"
                           FontSize="22" FontWeight="Bold"
                           Foreground="{StaticResource TextoPrimarioBrush}"/>
                <TextBlock Text="Ingresa tus credenciales para continuar"
                           FontSize="12"
                           Foreground="{StaticResource TextoSecundarioBrush}"
                           Margin="0,2,0,20"/>

                <TextBlock Text="Usuario" FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource TextoSecundarioBrush}" Margin="1,0,0,5"/>
                <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Escribe tu nombre de usuario"/>

                <TextBlock Text="Contrasena" FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource TextoSecundarioBrush}" Margin="1,4,0,5"/>
                <PasswordBox x:Name="passwordBox" PasswordChar="*"
                             PasswordChanged="PasswordBox_PasswordChanged"
                             Background="#F8FAFC" BorderBrush="#E2E8F0"
                             BorderThickness="1.5" Padding="11,9"
                             FontSize="13" Margin="0,0,0,8"/>

                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="#DC2626" FontWeight="SemiBold"
                           FontSize="12" TextWrapping="Wrap"
                           Margin="0,0,0,12"/>

                <Button Content="Entrar al sistema"
                        Command="{Binding LoginCommand}"
                        Height="44" IsDefault="True"/>

                <TextBlock Text="Semana 03 · ADO.NET"
                           FontSize="11"
                           Foreground="{StaticResource TextoSecundarioBrush}"
                           HorizontalAlignment="Center" Margin="0,10,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
