<UserControl x:Class="WpfApp1.Views.AulasDataTableView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <GroupBox Header="Aulas — Modo Desconectado (SqlDataAdapter / DataTable)">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Toolbar -->
            <Border Grid.Row="0" Margin="0,0,0,12" Padding="0,0,0,12"
                    BorderBrush="{StaticResource BordeBrush}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="Cargar registros"
                            Command="{Binding CargarCommand}" Margin="0,0,0,0"/>
                    <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0"
                               FontSize="12" Foreground="{StaticResource TextoSecundarioBrush}">
                        Datos obtenidos con SqlDataAdapter. La conexion se cierra automaticamente tras llenar el DataTable.
                    </TextBlock>
                </Grid>
            </Border>

            <!-- DataGrid -->
            <DataGrid Grid.Row="1"
                      ItemsSource="{Binding AulasTable}"
                      AutoGenerateColumns="True"
                      IsReadOnly="True"
                      CanUserAddRows="False"/>
        </Grid>
    </GroupBox>
</UserControl>
