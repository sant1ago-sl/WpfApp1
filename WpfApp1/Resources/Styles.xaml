<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===== PALETA FLUENT WINDOWS 11 (Modern Light) ===== -->
    <SolidColorBrush x:Key="PrimarioBrush"        Color="#4F46E5"/>
    <SolidColorBrush x:Key="PrimarioClaroBrush"   Color="#6366F1"/>
    <SolidColorBrush x:Key="PrimarioOscuroBrush"  Color="#4338CA"/>
    <SolidColorBrush x:Key="FondoBrush"           Color="#F8FAFC"/>
    <SolidColorBrush x:Key="SuperficieBrush"      Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BordeBrush"           Color="#E2E8F0"/>
    <SolidColorBrush x:Key="TextoPrimarioBrush"   Color="#0F172A"/>
    <SolidColorBrush x:Key="TextoSecundarioBrush" Color="#64748B"/>
    <SolidColorBrush x:Key="FilaAlternaBrush"     Color="#F8FAFC"/>
    <SolidColorBrush x:Key="SombrioBrush"         Color="#F1F5F9"/>

    <!-- Sombras de elevacion -->
    <DropShadowEffect x:Key="SombraCard"  BlurRadius="18" ShadowDepth="2" Direction="270" Color="#0F172A" Opacity="0.06"/>
    <DropShadowEffect x:Key="SombraBoton" BlurRadius="10" ShadowDepth="2" Direction="270" Color="#4F46E5" Opacity="0.30"/>

    <!-- ===== TEXTBLOCK ===== -->
    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextoPrimarioBrush}"/>
    </Style>

    <Style TargetType="Label">
        <Setter Property="Foreground" Value="{StaticResource TextoSecundarioBrush}"/>
        <Setter Property="FontSize"   Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding"    Value="0,0,0,4"/>
    </Style>

    <!-- ===== BUTTON (Estilo primario - Indigo) ===== -->
    <Style TargetType="Button">
        <Setter Property="Background"      Value="{StaticResource PrimarioBrush}"/>
        <Setter Property="Foreground"      Value="White"/>
        <Setter Property="Padding"         Value="18,9"/>
        <Setter Property="FontSize"        Value="13"/>
        <Setter Property="FontWeight"      Value="SemiBold"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Margin"          Value="0,4"/>
        <Setter Property="Effect"          Value="{StaticResource SombraBoton}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" Background="{TemplateBinding Background}"
                            CornerRadius="10" Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <TextBlock Text="{TemplateBinding Content}"
                                   Foreground="{TemplateBinding Foreground}"
                                   FontSize="{TemplateBinding FontSize}"
                                   FontWeight="{TemplateBinding FontWeight}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource PrimarioClaroBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource PrimarioOscuroBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Background" Value="#CBD5E1"/>
                            <Setter Property="Foreground" Value="#94A3B8"/>
                            <Setter Property="Effect" Value="{x:Null}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== NAVBUTTONSTYLE (Botones del menu lateral) ===== -->
    <Style x:Key="NavButtonStyle" TargetType="Button">
        <Setter Property="Background"      Value="#EEF2FF"/>
        <Setter Property="Foreground"      Value="#4338CA"/>
        <Setter Property="Padding"         Value="14,9"/>
        <Setter Property="FontSize"        Value="13"/>
        <Setter Property="FontWeight"      Value="Medium"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Margin"          Value="0,2"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" Background="{TemplateBinding Background}"
                            CornerRadius="8" Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <TextBlock Text="{TemplateBinding Content}"
                                   Foreground="{TemplateBinding Foreground}"
                                   FontSize="{TemplateBinding FontSize}"
                                   FontWeight="{TemplateBinding FontWeight}"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#E0E7FF"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#C7D2FE"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== TEXTBOX ===== -->
    <Style TargetType="TextBox">
        <Setter Property="Background"      Value="#F8FAFC"/>
        <Setter Property="Foreground"      Value="{StaticResource TextoPrimarioBrush}"/>
        <Setter Property="BorderBrush"     Value="{StaticResource BordeBrush}"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="Padding"         Value="11,9"/>
        <Setter Property="FontSize"        Value="13"/>
        <Setter Property="Margin"          Value="0,0,0,10"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="border" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="border" Property="Background"  Value="#FFFFFF"/>
                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource PrimarioBrush}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="#CBD5E1"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== GROUPBOX / CARD ===== -->
    <Style TargetType="GroupBox">
        <Setter Property="BorderBrush"     Value="{StaticResource BordeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Margin"          Value="0,0,0,12"/>
        <Setter Property="Padding"         Value="16"/>
        <Setter Property="Effect"          Value="{StaticResource SombraCard}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GroupBox">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="{StaticResource SombrioBrush}"
                                CornerRadius="10" Padding="14,6"
                                HorizontalAlignment="Left" Margin="16,0,0,-2" Panel.ZIndex="1">
                            <ContentPresenter ContentSource="Header"
                                              TextElement.Foreground="{StaticResource TextoPrimarioBrush}"
                                              TextElement.FontWeight="SemiBold"
                                              TextElement.FontSize="12"/>
                        </Border>
                        <Border Grid.Row="1" Background="{StaticResource SuperficieBrush}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12" Margin="0,10,0,0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== COMBOBOX ===== -->
    <Style TargetType="ComboBox">
        <Setter Property="Background"      Value="#F8FAFC"/>
        <Setter Property="BorderBrush"     Value="{StaticResource BordeBrush}"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="Foreground"      Value="{StaticResource TextoPrimarioBrush}"/>
        <Setter Property="Padding"         Value="11,7"/>
        <Setter Property="FontSize"        Value="13"/>
        <Setter Property="Margin"          Value="0,0,0,10"/>
    </Style>

    <!-- ===== CHECKBOX ===== -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource TextoPrimarioBrush}"/>
        <Setter Property="FontSize"   Value="13"/>
        <Setter Property="Cursor"     Value="Hand"/>
        <Setter Property="Margin"     Value="0,4"/>
    </Style>

    <!-- ===== DATEPICKER ===== -->
    <Style TargetType="DatePicker">
        <Setter Property="FontSize"        Value="13"/>
        <Setter Property="BorderBrush"     Value="{StaticResource BordeBrush}"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="Padding"         Value="8,6"/>
    </Style>

    <!-- ===== DATAGRID COLUMN HEADER ===== -->
    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background"                 Value="#F1F5F9"/>
        <Setter Property="Foreground"                 Value="{StaticResource TextoSecundarioBrush}"/>
        <Setter Property="FontWeight"                 Value="SemiBold"/>
        <Setter Property="FontSize"                   Value="12"/>
        <Setter Property="Padding"                    Value="12,10"/>
        <Setter Property="BorderBrush"                Value="#E2E8F0"/>
        <Setter Property="BorderThickness"            Value="0,0,0,1"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
    </Style>

    <!-- ===== DATAGRID ===== -->
    <Style TargetType="DataGrid">
        <Setter Property="Background"               Value="{StaticResource SuperficieBrush}"/>
        <Setter Property="Foreground"               Value="{StaticResource TextoPrimarioBrush}"/>
        <Setter Property="RowBackground"            Value="{StaticResource SuperficieBrush}"/>
        <Setter Property="AlternatingRowBackground" Value="{StaticResource FilaAlternaBrush}"/>
        <Setter Property="BorderBrush"              Value="{StaticResource BordeBrush}"/>
        <Setter Property="BorderThickness"          Value="1"/>
        <Setter Property="GridLinesVisibility"      Value="None"/>
        <Setter Property="RowHeight"                Value="38"/>
        <Setter Property="HeadersVisibility"        Value="Column"/>
        <Setter Property="CanUserResizeRows"        Value="False"/>
        <Setter Property="SelectionUnit"            Value="FullRow"/>
    </Style>

    <!-- ===== DATAGRID CELL ===== -->
    <Style TargetType="DataGridCell">
        <Setter Property="Foreground"      Value="{StaticResource TextoPrimarioBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontSize"        Value="13"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Background="{TemplateBinding Background}" Padding="12,0">
                        <ContentPresenter VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="#EEF2FF"/>
                <Setter Property="Foreground" Value="#4338CA"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===== DATAGRID ROW (hover suave) ===== -->
    <Style TargetType="DataGridRow">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#F5F7FF"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="#EEF2FF"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===== STATUSBAR ===== -->
    <Style TargetType="StatusBar">
        <Setter Property="Background" Value="#F1F5F9"/>
    </Style>
    <Style TargetType="StatusBarItem">
        <Setter Property="Foreground" Value="{StaticResource TextoSecundarioBrush}"/>
        <Setter Property="Padding"    Value="10,4"/>
        <Setter Property="FontSize"   Value="12"/>
    </Style>

</ResourceDictionary>
