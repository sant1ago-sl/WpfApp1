<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Paleta suave: grises cálidos y lavanda apagada -->
    <SolidColorBrush x:Key="PrimarioBrush" Color="#5B5F77"/>
    <SolidColorBrush x:Key="PrimarioClaroBrush" Color="#7A7F99"/>
    <SolidColorBrush x:Key="FondoBrush" Color="#EEF0F4"/>
    <SolidColorBrush x:Key="SuperficieBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BordeBrush" Color="#D9DCE3"/>
    <SolidColorBrush x:Key="TextoPrimarioBrush" Color="#2E3038"/>
    <SolidColorBrush x:Key="TextoSecundarioBrush" Color="#858A99"/>
    <SolidColorBrush x:Key="FilaAlternaBrush" Color="#F5F6F9"/>

    <!-- Texto base -->
    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextoPrimarioBrush}"/>
    </Style>

    <Style TargetType="Label">
        <Setter Property="Foreground" Value="{StaticResource TextoSecundarioBrush}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="0,0,0,3"/>
    </Style>

    <!-- Botones: gris azulado suave, pill redondeado -->
    <Style TargetType="Button">
        <Setter Property="Background" Value="{StaticResource PrimarioBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Padding" Value="18,9"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Margin" Value="0,4"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" Background="{TemplateBinding Background}"
                            CornerRadius="20" Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <TextBlock Text="{TemplateBinding Content}"
                                   Foreground="{TemplateBinding Foreground}"
                                   FontSize="{TemplateBinding FontSize}"
                                   FontWeight="{TemplateBinding FontWeight}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource PrimarioClaroBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#494D63"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Background" Value="#C9CCD6"/>
                            <Setter Property="Foreground" Value="#8E92A0"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- TextBox: tarjeta suave con foco lavanda -->
    <Style TargetType="TextBox">
        <Setter Property="Background" Value="#F3F4F7"/>
        <Setter Property="Foreground" Value="{StaticResource TextoPrimarioBrush}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="border" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#FFFFFF"/>
                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource PrimarioBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- GroupBox: tarjeta blanca con título suave -->
    <Style TargetType="GroupBox">
        <Setter Property="BorderBrush" Value="{StaticResource BordeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Margin" Value="0,0,0,12"/>
        <Setter Property="Padding" Value="14"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GroupBox">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="#E4E6EE" CornerRadius="12"
                                Padding="14,5" HorizontalAlignment="Left" Margin="14,0,0,-2" Panel.ZIndex="1">
                            <ContentPresenter ContentSource="Header" TextElement.Foreground="{StaticResource TextoPrimarioBrush}"
                                              TextElement.FontWeight="SemiBold" TextElement.FontSize="12"/>
                        </Border>
                        <Border Grid.Row="1" Background="{StaticResource SuperficieBrush}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12" Margin="0,12,0,0" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ComboBox -->
    <Style TargetType="ComboBox">
        <Setter Property="Background" Value="#F3F4F7"/>
        <Setter Property="BorderBrush" Value="{StaticResource BordeBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextoPrimarioBrush}"/>
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource TextoPrimarioBrush}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,4"/>
    </Style>

    <Style TargetType="DatePicker">
        <Setter Property="FontSize" Value="13"/>
    </Style>

    <!-- DataGrid: encabezado gris suave, sin bordes duros -->
    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="#E4E6EE"/>
        <Setter Property="Foreground" Value="{StaticResource TextoPrimarioBrush}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="10,9"/>
        <Setter Property="BorderBrush" Value="#D5D8E0"/>
        <Setter Property="BorderThickness" Value="0,0,1,1"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
    </Style>

    <Style TargetType="DataGrid">
        <Setter Property="Background" Value="{StaticResource SuperficieBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextoPrimarioBrush}"/>
        <Setter Property="RowBackground" Value="{StaticResource SuperficieBrush}"/>
        <Setter Property="AlternatingRowBackground" Value="{StaticResource FilaAlternaBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BordeBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="GridLinesVisibility" Value="None"/>
        <Setter Property="RowHeight" Value="34"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="CanUserResizeRows" Value="False"/>
    </Style>

    <Style TargetType="DataGridCell">
        <Setter Property="Foreground" Value="{StaticResource TextoPrimarioBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource PrimarioBrush}"/>
                <Setter Property="Foreground" Value="White"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- StatusBar suave -->
    <Style TargetType="StatusBar">
        <Setter Property="Background" Value="#E4E6EE"/>
    </Style>

    <Style TargetType="StatusBarItem">
        <Setter Property="Foreground" Value="{StaticResource TextoSecundarioBrush}"/>
        <Setter Property="Padding" Value="10,4"/>
    </Style>

</ResourceDictionary>